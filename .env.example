# -----------------------------------------------------------------------------
# Variables de entorno — Demo 1 (estudio de familia y sucesiones). SPEC §9.
#
# 1. Copiá este archivo a `.env.local` (está en .gitignore) y completá los valores.
# 2. Nunca pongas valores reales en este archivo: se commitea.
# 3. Se validan con Zod en src/lib/env.schema.ts. Si falta una obligatoria o tiene
#    un formato inválido, `npm run dev`, `build` y `start` fallan con un mensaje claro.
#    Desde F3-05 son obligatorias todas las de la Fase 3 (salvo DIRECT_URL): completá las
#    vacías antes de `npm run dev`.
# 4. Una variable vacía (KEY=) cuenta como no definida.
#
# Las variables NEXT_PUBLIC_* se incluyen en el JS del navegador: nunca pongas
# secretos en ellas.
# -----------------------------------------------------------------------------

# --- Sitio (obligatorias desde la Fase 1) ------------------------------------

# URL pública del sitio, sin barra final. Se usa para URLs absolutas, sitemap y OG.
# Local: http://localhost:3000 · Vercel: la URL del preview o del dominio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Muestra el banner "Sitio de demostración — estudio ficticio". Valores: true | false.
# Si no se define, vale true (ADR-0011): para un estudio real hay que poner false explícito.
NEXT_PUBLIC_DEMO_MODE=true

# --- Supabase Auth (obligatorias desde la Fase 4) ----------------------------

# Settings → API del proyecto de Supabase (dev para local y preview, prod para producción).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (o la anon key si el proyecto usa claves legacy). Es pública.
# No se usa la service role key (SPEC §9).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Base de datos / Prisma (obligatorias desde la Fase 3) -------------------
#
# Supabase → Connect → Connection string. Proyecto dev para local y preview, prod para
# producción. Con el pooler de Supabase el usuario es `postgres.<project-ref>`, no `postgres`.
# Si la contraseña tiene caracteres especiales (@ # / % : ?), van codificados en la URL
# (ej. @ → %40). No hace falta `?pgbouncer=true`: era para el motor de Prisma 6.
# Sin parámetros ssl* (sslmode, sslaccept, sslcert...): el código conecta con TLS verificado
# contra la CA de Supabase (prisma/certs/supabase-ca.crt) y rechaza las URLs que los traen.

# Runtime (la app): pooler en modo transacción, puerto 6543.
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Migraciones (solo la CLI de Prisma, ver prisma.config.ts): pooler en modo sesión, puerto 5432,
# o la conexión directa (db.<project-ref>.supabase.co, solo IPv6 en el plan gratuito).
# No se carga en Vercel: las migraciones se corren a mano (SPEC §14).
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# --- Mails / Resend (obligatorias desde la Fase 3) ---------------------------

# Resend → API Keys → Create (permiso "Sending access", no "Full access").
RESEND_API_KEY=
# Remitente: "Nombre <direccion>". Con dominio verificado en Resend: Estudio <avisos@tu-dominio.com>.
# Sin dominio (desarrollo): Estudio <onboarding@resend.dev>, que solo entrega a la casilla de tu
# cuenta de Resend. Nombre y dirección neutros: sin la especialidad del estudio (US-03 CA5).
# Nunca una dirección de gmail.com u otro proveedor gratuito: Resend no puede enviar desde un
# dominio que no verificaste (error "domain is not verified").
EMAIL_FROM=
# Casilla del estudio que recibe el aviso de cada consulta nueva. Solo la dirección, sin nombre
# ni <...>. Sin dominio verificado, tiene que ser la casilla de tu cuenta de Resend.
FIRM_NOTIFICATION_EMAIL=

# --- Cloudflare Turnstile (obligatorias desde la Fase 3) ---------------------

# En dev, test, CI y Preview de Vercel se usan las claves de prueba oficiales de Cloudflare
# (SPEC §8.2, ADR-0013), que siempre aprueban. Son públicas y documentadas. Las reales
# (Cloudflare → Turnstile → widget "Managed" con el dominio del sitio) van solo en Production.
# La secreta se usa solo en el servidor (siteverify) y nunca llega al navegador.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Upstash Redis / rate limit (obligatorias desde la Fase 3) ---------------

# Upstash → Redis → tu base → REST API: la URL (https://...upstash.io) y el token de escritura
# (no el "read-only"). Una base por instalación; región cercana a Vercel (us-east).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Seguridad (obligatoria desde la Fase 3) ---------------------------------

# Sal para el HMAC-SHA256 de las IPs. Mínimo 32 caracteres aleatorios.
# Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=
